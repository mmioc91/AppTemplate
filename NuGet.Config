<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    This project only uses public packages from nuget.org. The global NuGet.Config
    (%APPDATA%\NuGet\NuGet.Config) has extra internal sources (WebStudio, Asseco)
    that are unnecessary here and, combined with Central Package Management, raise
    an NU1507 warning (escalated to an error via TreatWarningsAsErrors in Directory.Build.props).

    <clear /> resets the sources for this repo only, so the build stays
    reproducible regardless of the user's global config.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
