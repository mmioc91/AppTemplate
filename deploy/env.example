# Settings for deploy/compose.yml — copy to deploy/.env (ignored by git) and fill in. Never commit the filled copy.

# The public address: a domain gets its HTTPS certificate from Caddy; ":8080" serves plain HTTP for a local try.
SITE_ADDRESS=app.example.com
ALLOWED_HOSTS=app.example.com

# Where the links in mail point: the site's address with its scheme (for a local try, http://localhost:8080).
WEB_BASE_URL=https://app.example.com

# Outgoing mail (ADR 0034): a TLS-capable SMTP relay; the password only with StartTls (587) or SslOnConnect (465).
# MAIL_DELIVERY_ENABLED=false keeps the queue filling without sending (a local try, a stack that must not mail).
MAIL_FROM_ADDRESS=noreply@app.example.com
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURITY=StartTls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_DELIVERY_ENABLED=true

# Secrets: openssl rand -base64 32 for each.
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# Sign-ins and registrations a minute per client IP (ADR 0031): what slows down guessing. Only the e2e suite against
# this stack needs more (ADR 0032): 100 for that run, 10 otherwise.
AUTH_RATE_LIMIT_PER_MINUTE=10

# The network between Caddy and the Api: the only proxy the Api believes about the client's address. Another stack on
# the same host (a second project from this template) needs a subnet of its own.
EDGE_SUBNET=172.29.0.0/24

# Ports on the host.
HTTP_PORT=80
HTTPS_PORT=443
LOCAL_PORT=8080
