/* The end-to-end tests and their config: type-checked by `npm run lint` (Playwright itself only strips the types). */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "e2e/**/*.mjs", "playwright.config.ts"]
}
