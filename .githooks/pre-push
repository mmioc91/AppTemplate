#!/usr/bin/env bash
# Blocks push to main, checks the branch name and runs the fast unit tests.
# Activated via: git config core.hooksPath .githooks

branch=$(git rev-parse --abbrev-ref HEAD)
# <type>/<description>, or claude/<name> for the worktree branches the Claude desktop app creates.
pattern='^((feat|fix|hotfix|refactor|perf|test|docs|chore|ci|infra)|claude)/[a-z0-9._-]+$'

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "❌ Don't push to '$branch' directly — make a branch and open a pull request."
  exit 1
fi

if ! echo "$branch" | grep -Eq "$pattern"; then
  echo "❌ Invalid branch name: $branch"
  echo "   Format:  <type>/<task-id>-<description>"
  echo "   Example: feat/fe-033-rapid-numpad"
  exit 1
fi

# Fast unit tests. Integration tests (Testcontainers) are intentionally NOT run here —
# they need Docker and take too long; their place is CI.
for p in tests/AppTemplate.Domain.Tests tests/AppTemplate.Application.Tests; do
  [ -d "$p" ] || continue
  echo "▶ Tests: $p"
  if ! dotnet test "$p" --nologo -v q; then
    echo "❌ Unit tests fail — push stopped."
    exit 1
  fi
done

echo "✅ Checks passed."
exit 0
