#!/usr/bin/env bash
# Blocks push to main, checks branch name and runs fast unit tests.
# Activated via: git config core.hooksPath .githooks

branch=$(git rev-parse --abbrev-ref HEAD)
pattern='^(feat|fix|hotfix|refactor|perf|test|docs|chore|ci|infra)/[a-z0-9._-]+$'

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "❌ Ne pushaj izravno na '$branch' — napravi granu i otvori pull request."
  exit 1
fi

if ! echo "$branch" | grep -Eq "$pattern"; then
  echo "❌ Neispravno ime grane: $branch"
  echo "   Format: <tip>/<task-id>-<opis>"
  echo "   Npr.:   feat/fe-033-rapid-numpad"
  exit 1
fi

# Fast unit tests. Integration tests (Testcontainers) are intentionally NOT run here —
# they need Docker and take too long; their place is CI.
for p in tests/AppTemplate.Domain.Tests tests/AppTemplate.Application.Tests; do
  [ -d "$p" ] || continue
  echo "▶ Testovi: $p"
  if ! dotnet test "$p" --nologo -v q; then
    echo "❌ Unit testovi padaju — push zaustavljen."
    exit 1
  fi
done

echo "✅ Provjere prošle."
exit 0
