#!/usr/bin/env bash
# Checks that the commit message follows Conventional Commits, the breaking marker (feat!:) included.
# Activated via: git config core.hooksPath .githooks

first_line=$(head -n1 "$1")
pattern='^(feat|fix|hotfix|refactor|perf|test|docs|chore|ci|infra)(\([a-z0-9.-]+\))?!?: .{1,60}$'

# Merge and revert commits are allowed through
if echo "$first_line" | grep -Eq '^(Merge|Revert)'; then
  exit 0
fi

if ! echo "$first_line" | grep -Eq "$pattern"; then
  echo "❌ The message doesn't follow Conventional Commits."
  echo ""
  echo "   Format:  <type>(<scope>): <description>   (a ! before the colon marks a breaking change)"
  echo "   Types:   feat fix hotfix refactor perf test docs chore ci infra"
  echo "   Example: feat(scoring): queue results while offline"
  echo ""
  echo "   Your message: $first_line"
  exit 1
fi

exit 0
