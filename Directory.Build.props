<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    TargetFramework is intentionally HERE, not in individual .csproj files.
    bootstrap.ps1 strips it from projects so this stays the single source of truth.

    If TreatWarningsAsErrors gets in your way while prototyping, feel free to
    temporarily set it to false — but restore it before the repo grows.
  -->

</Project>
